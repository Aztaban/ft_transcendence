#: apps/accounts/serializers/authentication.py:21
#: apps/accounts/views/authentication.py:37
msgid "An account with this email already exists."
msgstr "Ya existe una cuenta con este correo electrónico."

#: apps/accounts/serializers/oauth.py:35 apps/accounts/serializers/oauth.py:60
msgid "42 user ID must be a positive integer."
msgstr "El ID de usuario de 42 debe ser un entero positivo."

#: apps/accounts/serializers/roles.py:21
msgid "Unknown role."
msgstr "Rol desconocido."

#: apps/accounts/views/authentication.py:78
msgid "Please correct the registration fields."
msgstr "Corrija los campos del registro."

#: apps/accounts/views/authentication.py:92
msgid "Account created successfully."
msgstr "La cuenta se ha creado correctamente."

#: apps/accounts/views/authentication.py:137
msgid "Please correct the login fields."
msgstr "Corrija los campos de inicio de sesión."

#: apps/accounts/views/authentication.py:146
msgid "Invalid email or password."
msgstr "Correo electrónico o contraseña no válidos."

#: apps/accounts/views/authentication.py:156
msgid "Logged in successfully."
msgstr "Sesión iniciada correctamente."

#: apps/accounts/views/profiles.py:68
msgid "Please correct the profile fields."
msgstr "Corrija los campos del perfil."

#: apps/accounts/views/roles.py:49
msgid "You may not assign this role."
msgstr "No puede asignar este rol."

#: apps/accounts/views/roles.py:86
msgid "This role cannot be revoked."
msgstr "Este rol no se puede revocar."

#: apps/accounts/views/roles.py:90
msgid "You cannot change your own roles."
msgstr "No puede cambiar sus propios roles."

#: apps/core/exceptions.py:23
msgid "Please correct the highlighted fields."
msgstr "Corrija los campos resaltados."

#: apps/core/exceptions.py:24
msgid "Authentication required."
msgstr "Se requiere autenticación."

#: apps/core/exceptions.py:25
msgid "CSRF verification failed. Reload the page and try again."
msgstr "La verificación CSRF ha fallado. Vuelva a cargar la página e inténtelo de nuevo."

#: apps/core/exceptions.py:26 apps/evaluations/views/eligibility.py:100
#: apps/evaluations/views/eligibility.py:248
msgid "You do not have permission to perform this action."
msgstr "No tiene permiso para realizar esta acción."

#: apps/core/exceptions.py:27
msgid "Not found."
msgstr "No encontrado."

#: apps/core/exceptions.py:28
msgid "Method not allowed."
msgstr "Método no permitido."

#: apps/core/exceptions.py:29
msgid "The requested response format is not available."
msgstr "El formato de respuesta solicitado no está disponible."

#: apps/core/exceptions.py:30
msgid "Unsupported media type."
msgstr "Tipo de contenido no admitido."

#: apps/core/exceptions.py:31
msgid "Too many requests. Try again later."
msgstr "Demasiadas solicitudes. Inténtelo de nuevo más tarde."

#: apps/core/exceptions.py:32
msgid "Something went wrong. Please try again."
msgstr "Algo ha salido mal. Inténtelo de nuevo."

#: apps/evaluations/admin.py:61
msgid ""
"Results can only be entered for confirmed evaluations whose end time has "
"passed."
msgstr ""
"Los resultados solo se pueden introducir para evaluaciones confirmadas cuyo "
"horario de fin ya haya pasado."

#: apps/evaluations/permissions.py:18
msgid "You are not eligible to evaluate this project."
msgstr "No está habilitado para evaluar este proyecto."

#: apps/evaluations/permissions.py:24
msgid "You cannot pick your own request."
msgstr "No puede elegir su propia solicitud."

#: apps/evaluations/serializers/eligibility.py:59
msgid "Project ids must be distinct."
msgstr "Los ID de proyecto deben ser distintos."

#: apps/evaluations/serializers/eligibility.py:63
#, python-format
msgid "Select at most %(max)s projects."
msgstr "Seleccione como máximo %(max)s proyectos."

#: apps/evaluations/serializers/requests.py:91
msgid "Datetime must include a timezone (Z or an offset)."
msgstr "La fecha y hora deben incluir una zona horaria (Z o un desfase)."

#: apps/evaluations/serializers/requests.py:110
#, python-format
msgid "Time must be on a %(minutes)s-minute boundary, with zero seconds."
msgstr "La hora debe caer en un límite de %(minutes)s minutos, con cero segundos."

#: apps/evaluations/serializers/requests.py:116
#, python-format
msgid "Duration must be between %(minimum)s and %(maximum)s minutes."
msgstr "La duración debe estar entre %(minimum)s y %(maximum)s minutos."

#: apps/evaluations/serializers/requests.py:123
#, python-format
msgid "Start time must be at least %(minutes)s minutes from now."
msgstr "La hora de inicio debe ser al menos %(minutes)s minutos a partir de ahora."

#: apps/evaluations/serializers/requests.py:129
#, python-format
msgid "Start time must be at most %(days)s days from now."
msgstr "La hora de inicio debe ser como máximo %(days)s días a partir de ahora."

#: apps/evaluations/serializers/requests.py:169
msgid "End time must be after start time."
msgstr "La hora de fin debe ser posterior a la hora de inicio."

#: apps/evaluations/serializers/requests.py:207
msgid "Unknown project slug."
msgstr "Slug de proyecto desconocido."

#: apps/evaluations/services.py:26
msgid "You already have an active request for this project."
msgstr "Ya tiene una solicitud activa para este proyecto."

#: apps/evaluations/services.py:32
msgid "Only pending requests can be edited."
msgstr "Solo se pueden editar las solicitudes pendientes."

#: apps/evaluations/services.py:38
msgid "This request is no longer pending."
msgstr "Esta solicitud ya no está pendiente."

#: apps/evaluations/services.py:44
msgid "You already have an evaluation at that time."
msgstr "Ya tiene una evaluación a esa hora."

#: apps/evaluations/services.py:50
msgid "The student already has an evaluation at that time."
msgstr "El estudiante ya tiene una evaluación a esa hora."

#: apps/evaluations/services.py:56
msgid "This evaluation has already started."
msgstr "Esta evaluación ya ha comenzado."

#: apps/evaluations/services.py:99 apps/evaluations/services.py:110
msgid "Only requests awaiting confirmation can be confirmed."
msgstr "Solo se pueden confirmar las solicitudes que esperan confirmación."

#: apps/evaluations/services.py:138
msgid "Only requests awaiting confirmation can be declined."
msgstr "Solo se pueden rechazar las solicitudes que esperan confirmación."

#: apps/evaluations/services.py:155 apps/evaluations/services.py:160
#: apps/evaluations/services.py:177
msgid "Only active requests without a result can be cancelled."
msgstr "Solo se pueden cancelar las solicitudes activas sin resultado."

#: apps/evaluations/services.py:189 apps/evaluations/services.py:196
#: apps/evaluations/services.py:211
msgid "Only picked requests without a result can be released."
msgstr "Solo se pueden liberar las solicitudes elegidas sin resultado."

#: apps/evaluations/views/eligibility.py:73
msgid "This field may not be blank."
msgstr "Este campo no puede estar en blanco."

#: apps/evaluations/views/eligibility.py:79
#, python-format
msgid "Unknown status: %(value)s."
msgstr "Estado desconocido: %(value)s."

#: apps/evaluations/views/eligibility.py:86
msgid "Ordering must be one of: created_at, -created_at."
msgstr "El orden debe ser uno de: created_at, -created_at."

#: apps/evaluations/views/eligibility.py:115
#, python-format
msgid "Unknown or inactive project id(s): %(ids)s."
msgstr "ID de proyecto desconocidos o inactivos: %(ids)s."

#: apps/evaluations/views/eligibility.py:129
#, python-format
msgid "Already eligible for: %(names)s."
msgstr "Ya está habilitado para: %(names)s."

#: apps/evaluations/views/eligibility.py:141
msgid "You already have a pending eligibility request."
msgstr "Ya tiene una solicitud de habilitación pendiente."

#: apps/evaluations/views/eligibility.py:255
msgid "You cannot review your own eligibility request."
msgstr "No puede revisar su propia solicitud de habilitación."

#: apps/evaluations/views/eligibility.py:278
msgid "This eligibility request has already been reviewed."
msgstr "Esta solicitud de habilitación ya ha sido revisada."

#: config/settings/base.py:120
msgid "English"
msgstr "Inglés"

#: config/settings/base.py:121
msgid "Czech"
msgstr "Checo"

#: config/settings/base.py:122
msgid "Spanish"
msgstr "Español"

#: apps/accounts/models.py:40
msgid "Deleted"
msgstr "Eliminado"

#: apps/accounts/views/admin_users.py
msgid "Deleted accounts cannot be edited."
msgstr "Las cuentas eliminadas no se pueden editar."

#: apps/accounts/exceptions.py
msgid "You cannot change your own account status."
msgstr "No puedes cambiar el estado de tu propia cuenta."

#: apps/accounts/exceptions.py
msgid "This action is not allowed in the user's current status."
msgstr "Esta acción no está permitida en el estado actual del usuario."

#: apps/accounts/services/deletion.py
msgid "Deleted user"
msgstr "Usuario eliminado"
