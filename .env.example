# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-dev
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- MySQL ---
MYSQL_DATABASE=transcendence
MYSQL_USER=transcendence
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- 42 Intra API v2 OAuth
FT_OAUTH_CLIENT_ID=YOUR_42_APPLICATION_UID
FT_OAUTH_CLIENT_SECRET=YOUR_42_APPLICATION_SECRET
FT_OAUTH_REDIRECT_URI=https://localhost/api/v1/auth/42/callback/
